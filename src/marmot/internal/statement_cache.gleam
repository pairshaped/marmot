//// Templates for the generated prepared-statement cache.
////
//// Marmot writes two files beside the generated query modules: a Gleam module
//// (`statement_cache.gleam`) that generated query functions call, and a small
//// Erlang FFI file next to it. Both are plain source in the user's project, so
//// app runtime code depends on generated code and on `sqlight`, not on Marmot.
////
//// The cache keeps compiled SQLite statements in each process's process
//// dictionary, keyed by connection and SQL text. Nothing is shared between
//// processes, so a statement is never stepped by two callers at once, and the
//// cache dies with its process.
////
//// Invariants:
//// - The generated `query` function has `sqlight.query`'s signature, so it can
////   stand in for `sqlight.query` and be wrapped by a `query_function`.
//// - A statement is reset after every use, including after bind and step errors.
//// - A closed connection never runs a cached statement.
//// - On targets other than Erlang the Gleam module falls back to `sqlight.query`.

import gleam/list
import gleam/string

/// Default import path of the generated cache module, used when callers do not
/// say where the module will be written.
pub const default_module_path = "generated/sql/statement_cache"

/// The last path segment of a Gleam module path, which is the name generated
/// code uses to call into it.
pub fn module_alias(module_path: String) -> String {
  case string.split(module_path, "/") |> list.last {
    Ok(alias) -> alias
    Error(_) -> module_path
  }
}

/// Erlang module name for the FFI file that belongs to a generated cache module.
/// It mirrors the name Gleam gives the compiled module, so two output
/// directories never produce the same Erlang module.
pub fn ffi_module_name(module_path: String) -> String {
  string.replace(module_path, "/", "@") <> "_ffi"
}

/// Source of the generated Gleam cache module.
pub fn gleam_source(module_path: String) -> String {
  let ffi = ffi_module_name(module_path)
  "//// Generated by Marmot. Do not edit.
////
//// Prepared-statement cache used by generated query functions.
////
//// `query` has the same signature as `sqlight.query`, but on Erlang it keeps
//// each compiled statement and reuses it. The cache lives in the calling
//// process, keyed by connection and SQL text, so it stays warm in a long-lived
//// process and starts cold in a new one. Only pass SQL that comes from a fixed
//// set of strings, as generated code does: nothing is ever evicted.
////
//// On other targets `query` calls `sqlight.query` without caching.

import gleam/dynamic/decode.{type Decoder, type Dynamic}
import gleam/list
import gleam/result
import gleam/string
import sqlight

/// Run a query with a cached statement. Behaves like `sqlight.query`.
pub fn query(
  sql: String,
  on connection: sqlight.Connection,
  with arguments: List(sqlight.Value),
  expecting decoder: Decoder(a),
) -> Result(List(a), sqlight.Error) {
  use rows <- result.try(run_query(sql, connection, arguments))
  list.try_map(rows, decode.run(_, decoder))
  |> result.map_error(decode_error)
}

/// Drop this process's cached statements for a connection and release them.
/// Other processes keep their own caches, which end when those processes end.
@external(erlang, \"" <> ffi <> "\", \"forget\")
pub fn forget(db _db: sqlight.Connection) -> Nil {
  Nil
}

/// Drop this process's cached statements for a connection, then close it.
/// Use this instead of `sqlight.close` in a long-lived process.
pub fn close(db db: sqlight.Connection) -> Result(Nil, sqlight.Error) {
  let _ = forget(db:)
  sqlight.close(db)
}

@external(erlang, \"" <> ffi <> "\", \"query\")
fn run_query(
  sql: String,
  connection: sqlight.Connection,
  arguments: List(sqlight.Value),
) -> Result(List(Dynamic), sqlight.Error) {
  sqlight.query(sql, on: connection, with: arguments, expecting: decode.dynamic)
}

fn decode_error(errors: List(decode.DecodeError)) -> sqlight.Error {
  let assert [decode.DecodeError(expected, actual, path), ..] = errors
  let message =
    \"Decoder failed, expected \"
    <> expected
    <> \", got \"
    <> actual
    <> \" in \"
    <> string.join(path, \".\")
  sqlight.SqlightError(code: sqlight.GenericError, message:, offset: -1)
}
"
}

/// Source of the generated Erlang FFI module.
pub fn erlang_source(module_path: String) -> String {
  "%% Generated by Marmot. Do not edit.
%%
%% Per-process prepared statement cache behind the generated statement_cache
%% module.
%%
%% Each process keeps, in its own process dictionary, one map of SQL text to
%% compiled statement per connection. Statements are never shared between
%% processes, so no statement is stepped by two callers at once, and they are
%% released when the process ends. The set of SQL strings is fixed by the
%% generated query functions, so the cache holds at most one statement per
%% distinct query and connection and never evicts.
-module('" <> ffi_module_name(module_path) <> "').
-export([query/3, forget/1]).

%% Process dictionary keys are {?MODULE, Conn}, so each generated cache only
%% sees its own entries.

%% Run Sql on Conn and return {ok, Rows} or {error, SqlightError}.
%% The check that Conn is open and the statement that follows are not atomic:
%% another process closing a shared connection in between is not guarded.
query(Sql, Conn, Args) ->
    case is_open(Conn) of
        true ->
            cached(Sql, Conn, Args);
        false ->
            %% Querying a closed connection releases its statements too.
            forget(Conn),
            uncached(Sql, Conn, Args)
    end.

%% Drop this process's statements for Conn and release them.
forget(Conn) ->
    case erlang:erase({?MODULE, Conn}) of
        undefined -> ok;
        _ -> erlang:garbage_collect()
    end,
    nil.

cached(Sql, Conn, Args) ->
    Key = {?MODULE, Conn},
    Statements = case erlang:get(Key) of
        undefined -> track(Key);
        Known -> Known
    end,
    case Statements of
        #{Sql := Stmt} ->
            run(Stmt, Sql, Conn, Key, Args);
        #{} ->
            case esqlite3:prepare(Conn, Sql, [persistent]) of
                {ok, Stmt} ->
                    erlang:put(Key, Statements#{Sql => Stmt}),
                    run(Stmt, Sql, Conn, Key, Args);
                {error, Code} ->
                    error_result(Conn, Code)
            end
    end.

%% First use of Conn in this process. Closing a connection keeps its file open
%% while statements are alive, so release the statements of connections this
%% process used before that are closed now.
track(Key) ->
    Closed = [Old || {?MODULE, Other} = Old <- erlang:get_keys(),
                     not is_open(Other)],
    lists:foreach(fun erlang:erase/1, Closed),
    case Closed of
        [] -> ok;
        _ -> erlang:garbage_collect()
    end,
    erlang:put(Key, #{}),
    #{}.

run(Stmt, Sql, Conn, Key, Args) ->
    try
        case esqlite3:bind(Stmt, Args) of
            ok ->
                ok = bind_missing(Stmt, length(Args) + 1),
                fetch(Stmt, Conn, []);
            {error, Code} ->
                failed(Stmt, Conn, Code)
        end
    catch
        Class:Reason:Stack ->
            discard(Key, Sql, Stmt),
            erlang:raise(Class, Reason, Stack)
    end.

%% A reused statement keeps the values bound by its previous call, so any
%% parameter the caller did not supply must be set back to NULL, which is what
%% a freshly compiled statement would have.
bind_missing(Stmt, Index) ->
    case esqlite3:bind_null(Stmt, Index) of
        ok -> bind_missing(Stmt, Index + 1);
        {error, _} -> ok
    end.

fetch(Stmt, Conn, Rows) ->
    case esqlite3:step(Stmt) of
        Row when is_list(Row) -> fetch(Stmt, Conn, [list_to_tuple(Row) | Rows]);
        '$done' -> {ok, lists:reverse(Rows)};
        '$busy' -> failed(Stmt, Conn, 5);
        {error, Code} -> failed(Stmt, Conn, Code)
    end.

%% Read the error before resetting: the statement must be ready for the next
%% call, and the connection's error message is only valid until then.
failed(Stmt, Conn, Code) ->
    Error = error_result(Conn, Code),
    _ = esqlite3:reset(Stmt),
    Error.

%% After an exception the statement's state is unknown, so reset it and let the
%% next call compile a new one.
discard(Key, Sql, Stmt) ->
    try esqlite3:reset(Stmt) catch _:_ -> ok end,
    case erlang:get(Key) of
        #{Sql := _} = Statements -> erlang:put(Key, maps:remove(Sql, Statements));
        _ -> ok
    end.

%% Closed connections, and anything that is not a connection, take the same
%% uncached path as sqlight.query so they fail exactly as before. A cached
%% statement of a closed connection must never run: SQLite keeps it working.
uncached(Sql, Conn, Args) ->
    case esqlite3:q(Conn, Sql, Args) of
        {error, Code} -> error_result(Conn, Code);
        Rows -> {ok, [list_to_tuple(Row) || Row <- Rows]}
    end.

is_open(Conn) ->
    try esqlite3:get_autocommit(Conn) of
        _ -> true
    catch
        error:_ -> false
    end.

error_result(Conn, Code) when is_integer(Code) ->
    #{errmsg := Message, error_offset := Offset} = esqlite3:error_info(Conn),
    {error, {sqlight_error, sqlight:error_code_from_int(Code), Message, Offset}}.
"
}
